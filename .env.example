NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never import or expose SUPABASE_SERVICE_ROLE_KEY in Client Components.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only n8n webhook
N8N_HEALTH_QUESTION_WEBHOOK_URL=https://your-n8n-domain/webhook/your-webhook-id

# Server-only. Used by n8n Website Publish Executor when calling POST /api/publish-content.
PUBLISH_API_SECRET=
